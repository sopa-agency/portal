# =============================================================================
# REQUIRED — Shared infra (all tenants use these)
# =============================================================================

# Postgres for the portal. Use a DEDICATED database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portal"

# Login session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# =============================================================================
# MULTI-TENANT PROJECT SELECTION
# =============================================================================

# Which project is served from bare localhost / apex domain.
# Defaults to "skatehive" when unset.
PORTAL_DEFAULT_PROJECT=skatehive

# =============================================================================
# PER-PROJECT SECRETS — namespaced as {SLUG}_{KEY}
# =============================================================================
#
# Each project has its own set of secrets. The naming convention is:
#   {UPPERCASE_SLUG}_GATEWAY_URL
#   {UPPERCASE_SLUG}_GATEWAY_TOKEN
#   {UPPERCASE_SLUG}_PORTAL_DEVICE_ID
#   {UPPERCASE_SLUG}_PORTAL_DEVICE_PUBLIC_KEY
#   {UPPERCASE_SLUG}_PORTAL_DEVICE_PRIVATE_KEY_BASE64
#
# Shared publishing secrets (Hive posting key, Neynar, Pinata) stay global
# for now — they can be namespaced later if tenants need separate accounts.
#
# ---------------------------------------------------------------------------
# SKATEHIVE PROJECT
# ---------------------------------------------------------------------------
# NOTE: SkateHive also falls back to the legacy global names below (GATEWAY_TOKEN,
# OPENCLAW_GATEWAY_URL, OPENCLAW_PORTAL_DEVICE_*) so existing .env.local files
# require ZERO changes when running only the skatehive tenant.

SKATEHIVE_GATEWAY_URL=
SKATEHIVE_GATEWAY_TOKEN=
SKATEHIVE_PORTAL_DEVICE_ID=
SKATEHIVE_PORTAL_DEVICE_PUBLIC_KEY=
SKATEHIVE_PORTAL_DEVICE_PRIVATE_KEY_BASE64=

# ---------------------------------------------------------------------------
# GNARS PROJECT
# ---------------------------------------------------------------------------
GNARS_GATEWAY_URL=
GNARS_GATEWAY_TOKEN=
GNARS_PORTAL_DEVICE_ID=
GNARS_PORTAL_DEVICE_PUBLIC_KEY=
GNARS_PORTAL_DEVICE_PRIVATE_KEY_BASE64=

# ---------------------------------------------------------------------------
# REELFLIP PROJECT
# ---------------------------------------------------------------------------
REELFLIP_GATEWAY_URL=
REELFLIP_GATEWAY_TOKEN=
REELFLIP_PORTAL_DEVICE_ID=
REELFLIP_PORTAL_DEVICE_PUBLIC_KEY=
REELFLIP_PORTAL_DEVICE_PRIVATE_KEY_BASE64=

# =============================================================================
# PUBLISHING — Hive (shared across tenants; set per-project if needed later)
# =============================================================================

# Hive account that posts snaps (e.g. "skatehive")
HIVE_POSTING_ACCOUNT=
# Posting key for that account. KEEP SECRET — full posting rights.
HIVE_POSTING_KEY=

# =============================================================================
# PUBLISHING — Farcaster (cast via Neynar managed signer)
# =============================================================================

# Neynar API key — get from https://neynar.com/
NEYNAR_API_KEY=
# UUID of the managed signer registered for the posting account on Neynar
NEYNAR_SIGNER_UUID=
# Optional: only needed if signer needs to be re-registered programmatically
FARCASTER_MNEMONIC=

# =============================================================================
# UPLOADS — Pinata IPFS gateway (used by Repo-to-Social image uploads)
# =============================================================================

# Pinata JWT — get from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# =============================================================================
# REPO-TO-SOCIAL — GitHub commits
# =============================================================================

# Optional: bumps GitHub API rate limit when fetching commits. A read-only
# personal access token with no scopes is enough.
GITHUB_TOKEN=

# =============================================================================
# LEGACY GLOBAL KEYS — SkateHive fallback (backward compat; prefer SKATEHIVE_* above)
# =============================================================================

# HackMD API token — publishes meeting atas and lists team notes (SOPA Reuniões
# + Campaign Creator). Get it at hackmd.io → Settings → API.
HACKMD_API_KEY=

# Reelflip magazine sync trigger — bearer secret for POST /api/reelflip/sync
# (mirrors the @reelflip Instagram into ReelflipPost). Falls back to CRON_SECRET;
# a global-admin session also authorizes. Uses REELFLIP_INSTAGRAM_* + PINATA_JWT.
REELFLIP_SYNC_SECRET=

# OpenClaw gateway URL — used when SKATEHIVE_GATEWAY_URL is not set.
OPENCLAW_GATEWAY_URL=

# Required for production device-signed WebSocket transport.
# When SKATEHIVE_* equivalents are not set, these are read as fallbacks.
GATEWAY_TOKEN=
OPENCLAW_PORTAL_DEVICE_ID=
OPENCLAW_PORTAL_DEVICE_PUBLIC_KEY=
OPENCLAW_PORTAL_DEVICE_PRIVATE_KEY_BASE64=

# Optional overrides
# OPENCLAW_AGENT_ID=skatehive-marketing
# OPENCLAW_GATEWAY_TOKEN=   # only used by worker; reads from ~/.openclaw/.env when blank
# OPENCLAW_ENV_FILE=~/.openclaw/.env
# OPENCLAW_TIMEOUT_MS=120000

# =============================================================================
# USERBASE — Supabase project that holds SkateHive accounts + auth methods
# =============================================================================
# Source: skatehive-monorepo/apps/skatehive3.0 Supabase project.
# Used by the /userbase admin page (server-side, service-role).
# Service-role key bypasses RLS — keep secret, never expose to the browser.
SUPABASE_USERBASE_URL=
SUPABASE_USERBASE_SERVICE_ROLE_KEY=

# =============================================================================
# SCHEDULER — worker calls this when publishing scheduled posts
# =============================================================================

# Base URL the worker uses to call /api/scheduler/tick
# SCHEDULER_BASE_URL=http://localhost:3030
# Optional shared secret. If set, the worker sends `x-scheduler-secret` header.
# SCHEDULER_TICK_SECRET=

# =============================================================================
# WORKER TUNING (optional)
# =============================================================================

# WORKER_POLL_INTERVAL_MS=10000
# WORKER_STALE_LOCK_MS=600000

# =============================================================================
# SOCIAL METRICS — optional integrations for the Socials dashboard
# =============================================================================

# ---------------------------------------------------------------------------
# Instagram (Meta Graph API) — needed for Reelflip and any project with an IG
# channel. Requires a Meta App with `instagram_basic` + `pages_read_engagement`
# permissions and a connected Instagram Business Account.
#
# Per-project overrides (checked first):
#   ${UPPERCASE_PROJECT_SLUG}_INSTAGRAM_ACCESS_TOKEN
#   ${UPPERCASE_PROJECT_SLUG}_INSTAGRAM_BUSINESS_ACCOUNT_ID
# Global fallbacks (used when per-project vars are absent):
# ---------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# X / Twitter — metrics require the paid X API v2 (Basic tier or above).
# Set X_BEARER_TOKEN to enable; leave blank for the graceful "not connected"
# state shown on the Socials dashboard.
# ---------------------------------------------------------------------------
# X_BEARER_TOKEN=

# Farcaster member-signer QR onboarding (Settings → Meu Farcaster).
# Use a DEDICATED throwaway sponsor account, not a brand account.
FARCASTER_SPONSOR_MNEMONIC=
FARCASTER_SPONSOR_FID=
# Optional: paid Neynar key so member LIKES work (reactions are paid).
FARCASTER_SPONSOR_API_KEY=
