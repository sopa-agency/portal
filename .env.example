# =============================================================================
# REQUIRED
# =============================================================================

# Postgres for portal-skatehive. Use a DEDICATED database — do NOT reuse the
# odysee-growth-os DATABASE_URL or you'll write SkateHive runs into Odysee tables.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portal_skatehive"

# Login session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# =============================================================================
# PUBLISHING — Hive (skatehive snap broadcasting)
# =============================================================================

# Hive account that posts snaps (e.g. "skatehive")
HIVE_POSTING_ACCOUNT=
# Posting key for that account. KEEP SECRET — full posting rights.
HIVE_POSTING_KEY=

# =============================================================================
# PUBLISHING — Farcaster (cast in /skateboard as @skatehive via Neynar)
# =============================================================================

# Neynar API key — get from https://neynar.com/
NEYNAR_API_KEY=
# UUID of the managed signer registered for @skatehive on Neynar
NEYNAR_SIGNER_UUID=
# Optional: only needed if signer needs to be re-registered programmatically
FARCASTER_MNEMONIC=

# =============================================================================
# UPLOADS — Pinata IPFS gateway (used by Repo-to-Social image uploads)
# =============================================================================

# Pinata JWT — get from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# =============================================================================
# REPO-TO-SOCIAL — OpenClaw gateway for tweet generation
# =============================================================================

# Optional: bumps GitHub API rate limit when fetching commits. A read-only
# personal access token with no scopes is enough.
GITHUB_TOKEN=

# OpenClaw gateway URL.
# - LOCAL (the worker on the Mac mini): http://127.0.0.1:18789, reads token from ~/.openclaw/.env
# - PRODUCTION (Vercel): point at the publicly-reachable gateway, e.g. https://gateway.openclaw.com
OPENCLAW_GATEWAY_URL=

# Required when calling the gateway over the public internet (production).
# Read by src/lib/openclaw-gateway.ts via device-signed WebSocket handshake.
# Generate keys with: node scripts/openclaw-device-keygen.js
GATEWAY_TOKEN=
OPENCLAW_PORTAL_DEVICE_ID=
OPENCLAW_PORTAL_DEVICE_PUBLIC_KEY=
OPENCLAW_PORTAL_DEVICE_PRIVATE_KEY_BASE64=

# Optional overrides
# OPENCLAW_AGENT_ID=skatehive-marketing
# OPENCLAW_GATEWAY_TOKEN=   # only used by worker; reads from ~/.openclaw/.env when blank
# OPENCLAW_ENV_FILE=~/.openclaw/.env
# OPENCLAW_TIMEOUT_MS=120000

# =============================================================================
# USERBASE — Supabase project that holds SkateHive accounts + auth methods
# =============================================================================
# Source: skatehive-monorepo/apps/skatehive3.0 Supabase project (the one that
# powers userbase_users / userbase_auth_methods / userbase_identities).
# Used by the /userbase admin page in portal-skatehive (server-side, service-role).
# Service-role key bypasses RLS — keep secret, never expose to the browser.
SUPABASE_USERBASE_URL=
SUPABASE_USERBASE_SERVICE_ROLE_KEY=

# =============================================================================
# SCHEDULER — worker calls this when publishing scheduled posts
# =============================================================================

# Base URL the worker uses to call /api/scheduler/tick
# SCHEDULER_BASE_URL=http://localhost:3030
# Optional shared secret. If set, the worker sends `x-scheduler-secret` header.
# SCHEDULER_TICK_SECRET=

# =============================================================================
# WORKER TUNING (optional)
# =============================================================================

# WORKER_POLL_INTERVAL_MS=10000
# WORKER_STALE_LOCK_MS=600000
